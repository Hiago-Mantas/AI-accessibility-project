{
  "manifest_version": 3,
  "name": "Leitor Acessível com IA",
  "version": "0.1.0",
  "description": "Extrai e reestrutura o conteúdo de qualquer página para leitura em voz alta, mesmo em sites mal estruturados ou com SEO ruim.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Leitor Acessível"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
